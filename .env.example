# Copia este fichero a .env y rellena los valores en local.
# En Render estas variables viven en el dashboard, NUNCA en el repo ni en render.yaml.
# Aquí solo se documentan los nombres: jamás los valores reales.

# Postgres. Esquema postgresql+... (SQLite no está soportado, ver design.md).
DATABASE_URL=

# Clave Fernet para cifrar el bearer token de LaLiga de cada usuario.
# Generar con: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Secreto para firmar la cookie de sesión.
SESSION_SECRET=

# Opcionales (tienen defaults locales en src/fantasy/config.py)
# FANTASY_ENTORNO=local
# FANTASY_RETENCION_DIAS=90
# FANTASY_SCRAPE_INTERVALO_SEGUNDOS=5
# FANTASY_CONTACTO=
